[Unit]
Description=PXC watchdog: restart a node stuck in Joining
Wants=network-online.target
After=network-online.target
# No After=mysql.service on purpose: an ordering dependency would make this
# job wait behind a long SST start.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pxc-watchdog.sh
# Optional overrides for the settings at the top of the script.
EnvironmentFile=-/etc/default/pxc-watchdog
# Must be longer than the worst case, or systemd could kill the script between
# "stop" and "start": WAIT_SECONDS + STOP_TIMEOUT + ~2 min (defaults ~10 min).
TimeoutStartSec=15min
# Creates /var/lib/pxc-watchdog for the restart history.
StateDirectory=pxc-watchdog
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
