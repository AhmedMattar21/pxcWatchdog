#!/usr/bin/env bash
# Fake ss. Call N prints $MOCK_DIR/ss.N (nothing if it does not exist).
: "${MOCK_DIR:?MOCK_DIR must be set}"
n=$(( $(cat "$MOCK_DIR/ss.calls" 2>/dev/null || echo 0) + 1 ))
echo "$n" >"$MOCK_DIR/ss.calls"
echo "$*" >>"$MOCK_DIR/ss.args"
if [[ -f $MOCK_DIR/ss.$n ]]; then
    cat "$MOCK_DIR/ss.$n"
fi
